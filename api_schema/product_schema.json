{
    "controller": "ProductController",
    "basePath": "/api/products",
    "endpoints": [
        {
            "method": "POST",
            "path": "",
            "summary": "Add Product",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "example": "T-Shirt"
                                },
                                "description": {
                                    "type": "string",
                                    "example": "Cotton blue t-shirt"
                                },
                                "price": {
                                    "type": "number",
                                    "example": 29.99
                                },
                                "stockQuantity": {
                                    "type": "integer",
                                    "example": 100
                                },
                                "categoryId": {
                                    "type": "integer",
                                    "example": 5
                                },
                                "imageUrl": {
                                    "type": "string",
                                    "example": "http://example.com/img.jpg"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Product created",
                    "content": {
                        "application/json": {
                            "example": {
                                "id": 1,
                                "name": "T-Shirt"
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "GET",
            "path": "",
            "summary": "Get All Active Products (Public)",
            "parameters": [
                {
                    "name": "category",
                    "in": "query",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "search",
                    "in": "query",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "limit",
                    "in": "query",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "name": "offset",
                    "in": "query",
                    "schema": {
                        "type": "integer"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "List of products or paginated result",
                    "content": {
                        "application/json": {
                            "example": {
                                "content": [
                                    {
                                        "id": 1,
                                        "name": "T-Shirt",
                                        "price": 29.99
                                    }
                                ],
                                "totalElements": 1,
                                "totalPages": 1
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "GET",
            "path": "/{id}",
            "summary": "Get Product By ID",
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "integer"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Product details",
                    "content": {
                        "application/json": {
                            "example": {
                                "id": 1,
                                "name": "T-Shirt"
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "GET",
            "path": "/seller",
            "summary": "Get Seller Products",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "responses": {
                "200": {
                    "description": "Paginated seller products",
                    "content": {
                        "application/json": {
                            "example": {
                                "content": [],
                                "totalElements": 0
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "PUT",
            "path": "/{id}",
            "summary": "Update Product",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "requestBody": {
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ProductRequest"
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Updated product"
                }
            }
        },
        {
            "method": "DELETE",
            "path": "/{id}",
            "summary": "Delete Product",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "responses": {
                "200": {
                    "description": "Deleted"
                }
            }
        },
        {
            "method": "PATCH",
            "path": "/{id}/status",
            "summary": "Update Product Status",
            "requestBody": {
                "content": {
                    "application/json": {
                        "example": {
                            "status": "INACTIVE"
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Updated status"
                }
            }
        },
        {
            "method": "PATCH",
            "path": "/{id}/stock",
            "summary": "Update Product Stock",
            "requestBody": {
                "content": {
                    "application/json": {
                        "example": {
                            "stockQuantity": 50
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Updated stock"
                }
            }
        }
    ]
}