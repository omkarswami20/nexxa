{
    "controller": "AdminController",
    "basePath": "/api/admin",
    "endpoints": [
        {
            "method": "POST",
            "path": "/login",
            "summary": "Admin Login",
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string",
                                    "example": "admin@nexashop.com"
                                },
                                "password": {
                                    "type": "string",
                                    "example": "admin123"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Login success",
                    "content": {
                        "application/json": {
                            "example": {
                                "token": "eyJhbGciOiJIUzI1...",
                                "refreshToken": "eyJhbGciOiJIUzI1..."
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "GET",
            "path": "/pending",
            "summary": "Get Pending Sellers",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "responses": {
                "200": {
                    "description": "List of pending sellers",
                    "content": {
                        "application/json": {
                            "example": [
                                {
                                    "id": 1,
                                    "name": "Jane Seller",
                                    "email": "jane@seller.com",
                                    "storeName": "Jane's Store",
                                    "status": "PENDING_APPROVAL"
                                }
                            ]
                        }
                    }
                }
            }
        },
        {
            "method": "GET",
            "path": "/sellers",
            "summary": "Get All Sellers",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "responses": {
                "200": {
                    "description": "List of all sellers",
                    "content": {
                        "application/json": {
                            "example": [
                                {
                                    "id": 1,
                                    "name": "Jane Seller",
                                    "storeName": "Jane's Store",
                                    "status": "APPROVED"
                                }
                            ]
                        }
                    }
                }
            }
        },
        {
            "method": "PUT",
            "path": "/update-status",
            "summary": "Update Seller Status",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "sellerId": {
                                    "type": "integer",
                                    "example": 1
                                },
                                "newStatus": {
                                    "type": "string",
                                    "enum": [
                                        "APPROVED",
                                        "DENIED"
                                    ],
                                    "example": "APPROVED"
                                },
                                "rejectionReason": {
                                    "type": "string",
                                    "example": "Invalid documents"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Updated seller",
                    "content": {
                        "application/json": {
                            "example": {
                                "id": 1,
                                "status": "APPROVED"
                            }
                        }
                    }
                }
            }
        }
    ]
}