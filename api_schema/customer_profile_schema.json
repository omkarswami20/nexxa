{
    "controller": "CustomerProfileController",
    "basePath": "/api/customers",
    "endpoints": [
        {
            "method": "GET",
            "path": "/profile",
            "summary": "Get Profile",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "responses": {
                "200": {
                    "description": "Customer profile",
                    "content": {
                        "application/json": {
                            "example": {
                                "id": 1,
                                "name": "John Doe",
                                "email": "john@example.com",
                                "mobile": "1234567890",
                                "emailVerified": true,
                                "mobileVerified": true
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "PUT",
            "path": "/profile",
            "summary": "Update Profile",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "example": "John Doe Updated"
                                },
                                "mobile": {
                                    "type": "string",
                                    "example": "0987654321"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Updated profile",
                    "content": {
                        "application/json": {
                            "example": {
                                "id": 1,
                                "name": "John Doe Updated"
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "POST",
            "path": "/change-password",
            "summary": "Change Password",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "oldPassword": {
                                    "type": "string",
                                    "example": "oldSecret"
                                },
                                "newPassword": {
                                    "type": "string",
                                    "example": "newSecret"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Password updated",
                    "content": {
                        "application/json": {
                            "example": {
                                "message": "Password updated"
                            }
                        }
                    }
                },
                "400": {
                    "description": "Incorrect old password",
                    "content": {
                        "application/json": {
                            "example": {
                                "message": "Old password incorrect"
                            }
                        }
                    }
                }
            }
        }
    ]
}