{
    "controller": "CustomerAuthController",
    "basePath": "/api/customers",
    "endpoints": [
        {
            "method": "POST",
            "path": "/register",
            "summary": "Register a customer",
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "example": "John Doe"
                                },
                                "email": {
                                    "type": "string",
                                    "example": "john@example.com"
                                },
                                "password": {
                                    "type": "string",
                                    "example": "secret123"
                                },
                                "mobile": {
                                    "type": "string",
                                    "example": "1234567890"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Registered successfully",
                    "content": {
                        "application/json": {
                            "example": {
                                "id": 1,
                                "email": "john@example.com"
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "POST",
            "path": "/login",
            "summary": "Login customer",
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string",
                                    "example": "john@example.com"
                                },
                                "password": {
                                    "type": "string",
                                    "example": "secret123"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Login success",
                    "content": {
                        "application/json": {
                            "example": {
                                "token": "eyJhbGciOiJIUzI1...",
                                "refreshToken": "eyJhbGciOiJIUzI1..."
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "POST",
            "path": "/verify-email-otp",
            "summary": "Verify Email OTP",
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string",
                                    "example": "john@example.com"
                                },
                                "otp": {
                                    "type": "string",
                                    "example": "123456"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Valid OTP",
                    "content": {
                        "application/json": {
                            "example": {
                                "valid": true
                            }
                        }
                    }
                },
                "400": {
                    "description": "Invalid OTP",
                    "content": {
                        "application/json": {
                            "example": {
                                "valid": false,
                                "message": "Invalid or expired OTP"
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "POST",
            "path": "/verify-mobile-otp",
            "summary": "Verify Mobile OTP",
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "mobile": {
                                    "type": "string",
                                    "example": "1234567890"
                                },
                                "otp": {
                                    "type": "string",
                                    "example": "123456"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Valid OTP",
                    "content": {
                        "application/json": {
                            "example": {
                                "valid": true
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "POST",
            "path": "/forgot-password/request",
            "summary": "Request Password Reset OTP",
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string",
                                    "example": "john@example.com"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "OTP Sent",
                    "content": {
                        "application/json": {
                            "example": {
                                "message": "OTP sent"
                            }
                        }
                    }
                }
            }
        },
        {
            "method": "POST",
            "path": "/forgot-password/verify",
            "summary": "Reset Password with OTP",
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string",
                                    "example": "john@example.com"
                                },
                                "otp": {
                                    "type": "string",
                                    "example": "123456"
                                },
                                "newPassword": {
                                    "type": "string",
                                    "example": "newSecret123"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Password Updated",
                    "content": {
                        "application/json": {
                            "example": {
                                "message": "Password updated"
                            }
                        }
                    }
                }
            }
        }
    ]
}